{% for chapter in chapters %}
	{% set c = loop.index0 %}
	<h1 id="{{ c }}" data-md="{{ chapter.md }}">
		<span class="title">{{ chapter.title | safe }}</span>
		<a title="Permalink to this chapter" href="#{{ c }}">#</a>
		{% if proposal %}
		<span class="add-section" data-at="{{ c }}"></span>
		{% endif %}
	</h1>
	{% for section in chapter.body %}
		{% set s = loop.index0 %}
		<h2 id="{{ c }}-{{ s }}" data-md="{{ section.md }}">
			<span class="find-handle">{{ c }}.{{ s }}</span>
			<span class="permalink"><a title="Permalink to this section" href="#{{ c }}-{{ s }}">#</a></span>
			<span class="title">{{ section.title | safe }}</span>
			{% if proposal %}
			<span class="wrap-add"><span class="add-section" data-at="{{ c }}-{{ s }}"></span></span>
			{% endif %}
		</h2>
		<ol>
		{% for subsection in section.body %}
			{% set ss = loop.index0 %}
			<li id="{{ c }}-{{ s }}-{{ ss }}" data-md="{{ subsection.md }}">
				<span class="find-handle">{{ c }}.{{ s }}.{{ ss + 1 }}</span>
				<span class="permalink"><a title="Permalink to this section" href="#{{ c }}-{{ s }}-{{ ss }}">#</a></span>
				<span class="title">{{ subsection.title | safe }}</span>
				{% if proposal %}
				<span class="wrap-add"><span class="add-section" data-at="{{ c }}-{{ s }}-{{ ss }}"></span></span>
				{% endif %}
				{% if subsection.body %}
				<ol>
				{% for subsubsection in subsection.body %}
					{% set sss = loop.index0 %}
					<li id="{{ c }}-{{ s }}-{{ ss }}-{{ sss }}" data-md="{{ subsubsection.md }}">
						<span class="find-handle">{{ c }}.{{ s }}.{{ ss + 1 }}.{{ 'abcdefghijklmnopqrstuvwxyz'[sss] }}</span>
						<span class="permalink"><a title="Permalink to this section" href="#{{ c }}-{{ s }}-{{ ss }}-{{ sss }}">#</a></span>
						<span class="title">{{ subsubsection.title | safe }}</span>
						{% if proposal %}
						<span class="wrap-add"><span class="add-section" data-at="{{ c }}-{{ s }}-{{ ss }}-{{ sss }}"></span></span>
						{% endif %}
						{% if subsubsection.body %}
						<ol>
						{% for subsubsubsection in subsubsection.body %}
							{% set ssss = loop.index0 %}
							<li id="{{ c }}-{{ s }}-{{ ss }}-{{ sss }}-{{ ssss }}" data-md="{{ subsubsubsection.md }}">
								<span class="find-handle">{{ c }}.{{ s }}.{{ ss + 1 }}.{{
									'abcdefghijklmnopqrstuvwxyz'[sss]
								}}.{{ [
									'i', 'ii', 'iii', 'iv', 'v',
									'vi', 'vii', 'viii', 'ix', 'x',
									'xi', 'xii', 'xiii', 'xiv', 'xv',
									'xvi', 'xvii', 'xviii', 'xix', 'xx',
								][ssss] }}</span>
								<span class="permalink"><a title="Permalink to this section" href="#{{ c }}-{{ s }}-{{ ss }}-{{ sss }}-{{ ssss }}">#</a></span>
								<span class="title">{{ subsubsubsection.title | safe }}</span>
								{% if proposal %}
								<span class="wrap-add"><span class="add-section" data-at="{{ c }}-{{ s }}-{{ ss }}-{{ sss }}-{{ ssss }}"></span></span>
								{% endif %}
							</li>
							{% endfor %}
						</ol>
						{% endif %}
					</li>
				{% endfor %}
				</ol>
				{% endif %}
			</li>
		{% endfor %}
		</ol>
	{% endfor %}
{% endfor %}
